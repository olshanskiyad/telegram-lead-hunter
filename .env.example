# Скопируйте в .env и заполните. Файл .env не публикуйте и не добавляйте в git: здесь ключи и токены.

# === Telegram API аккаунта-читателя чатов ===
# Получить: https://my.telegram.org -> API development tools (нужен отдельный аккаунт, не основной)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# === Бот-админка ===
# Токен бота, созданного у @BotFather. Через него вы управляете клиентами, чатами и промптом
ADMIN_BOT_TOKEN=
# Telegram id администраторов через запятую (свой id покажет, например, @userinfobot)
ADMIN_IDS=
# Контакт, который клиенты видят в справке и в сообщении об окончании доступа
ADMIN_CONTACT=@your_contact
# Самостоятельная регистрация клиентов: true = любой, кто пришлёт боту-админке токен своего бота, получает
# пробный период. false (по умолчанию) = регистрировать может только администратор.
SELF_REGISTRATION=false

# === ИИ ===
# По умолчанию DeepSeek; подойдёт любой OpenAI-совместимый API (/chat/completions)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# === PostgreSQL ===
# В Docker Compose база поднимается сама, а адрес собирается из этих трёх значений.
# Пароль обязателен; без символов @ : / # ? % (они ломают адрес базы)
POSTGRES_USER=leadhunter
POSTGRES_PASSWORD=
POSTGRES_DB=leadhunter
# Нужно только при запуске без Docker Compose (python main.py):
# DATABASE_URL=postgresql://leadhunter:ВАШ_ПАРОЛЬ@localhost:5432/leadhunter

# === Сессия Telethon ===
# Создаётся командой python gen_session.py. В Docker Compose папка сессии задана сама (/app/data).
# Без Docker можно указать другую папку (по умолчанию текущая):
# SESSION_DIR=.
# Необязательно: сессия строкой base64 вместо файла, если у контейнера нет постоянного тома
# (python gen_session.py --print-base64). Эта строка даёт полный доступ к аккаунту: храните как пароль
SESSION_BASE64=

# === Вебхуки (необязательно) ===
# Пусто: клиентские боты работают через long polling, домен и HTTPS не нужны (рекомендуется).
# Для вебхуков укажите домен или IP с HTTPS и запускайте через docker-compose.webhook.yml (см. README).
# Порт должен быть одним из 443, 80, 88, 8443
WEBHOOK_HOST=
WEBHOOK_PORT=8443
CERT_PATH=/app/certs/webhook_cert.pem
KEY_PATH=/app/certs/webhook_key.pem
